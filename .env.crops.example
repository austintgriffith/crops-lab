# .env.crops — throwaway secrets shipped into the guest at RUN time only
# (Tier 3). Never baked into crops-gold. Copy to .env.crops (gitignored).

# Throwaway private key. Fund with dust. NEVER a real seed or a key you care about.
WALLET_PK=0xREPLACE_ME

# Optional: custom RPC. Leave empty to observe the wallet's DEFAULT path
# (that is the point — a custom RPC changes the route, e.g. MetaMask STX off).
RPC_URL=

# send-eth action
SEND_TO=0xREPLACE_ME
SEND_AMOUNT_ETH=0.0001
