# .env.crops — throwaway secrets shipped into the guest at RUN time only
# (Tier 3). Never baked into crops-gold. Copy to .env.crops (gitignored).
#
# Generate a throwaway mnemonic on the host:
#   cast wallet new-mnemonic --words 12
# then fund its account-0 address with dust. NEVER a real seed.

# Throwaway 12-word mnemonic (quote it — it has spaces). Imported by `lab warm`.
WALLET_MNEMONIC="word word word word word word word word word word word word"
# Account-0 address of that mnemonic (cast wallet address --mnemonic "...").
WALLET_ADDR=0xREPLACE_ME
# Password `lab warm` sets on the wallet vault; send actions unlock with it.
WALLET_PASSWORD="change-me-throwaway"

# --- send-eth (route 01) ---
# Recipient; leave unset to self-send. SEND_AMOUNT_ETH defaults to 0.0002.
SEND_TO=
SEND_AMOUNT_ETH=0.0002
# Broadcast gate: uncomment ONLY to actually submit a real mainnet tx.
# SEND_BROADCAST=1

# --- send-ens (route 02) ---
# An ENS name to send to; MetaMask resolves it. Defaults to ens.eth.
SEND_ENS=ens.eth

# --- deposit-aave (route 03) ---
AAVE_AMOUNT=0.0005
# AAVE_BROADCAST=1   # uncomment ONLY to actually supply
